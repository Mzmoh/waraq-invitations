# Enter real values ONLY in Vercel Environment Variables, never in GitHub.
WARAQ_TRIAL_ONLY=true
COOKIE_SECURE=true
PUBLIC_ORIGIN=https://YOUR-TRIAL-PROJECT.vercel.app
# Supabase Connect > Transaction pooler, port 6543; URL-encode password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@YOUR_POOLER_HOST:6543/postgres
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SET_PRIVATELY_IN_VERCEL
# CLI migration safety gate. Only synthetic, empty trial project.
WARAQ_TRIAL_PROJECT_REF=PROJECT_REF
# Optional, existing mail adapter. Without these recovery returns explicit 503.
# RESEND_API_KEY=SET_PRIVATELY_IN_VERCEL
# MAIL_FROM=WARAQ <verified-sender@example.com>
