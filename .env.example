HOST=127.0.0.1
PORT=3000
# Configure your HTTPS domain behind a reverse proxy before production.
# PUBLIC_ORIGIN=https://your-domain
# DATABASE_PATH=/persistent/private/invitations.sqlite
# COOKIE_SECURE=true
# NODE_ENV=production
# Optional: create an administrator before inviting users. Choose a unique
# email and a password of 12–128 characters. Remove these after first boot.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# Account emails: HTTPS delivery webhook accepting JSON {to,purpose,url}.
# The webhook must send a transactional email; do not log its payload.
# MAIL_DELIVERY_URL=https://your-mail-gateway.example/send
# MAIL_DELIVERY_TOKEN=
# Direct provider: set MAIL_PROVIDER=resend, sender must be verified in Resend.
# MAIL_PROVIDER=resend
# RESEND_API_KEY=
# MAIL_FROM=Waraq <invitations@your-verified-domain>
# TRUSTED_PROXY_IPS=172.30.0.2
# Compose TLS configuration:
# WARAQ_DOMAIN=
# ACME_EMAIL=
# BACKUP_ENCRYPTION_KEY=  (64 private hex characters, stored outside Git)

