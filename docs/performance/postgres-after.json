  "sql": {
    "sql": "WITH page AS (SELECT i.id,i.slug,i.templateId,i.status,i.updatedAt,i.pinHash,i.settings,jsonb_build_object('title',i.data::jsonb->>'title')::text AS data FROM invitations i WHERE i.owner=$1 ORDER BY i.updatedAt DESC,i.id DESC LIMIT $2), counts AS (SELECT invitation,count(*) AS replies FROM responses WHERE invitation IN(SELECT id FROM page) GROUP BY invitation) SELECT i.id,i.slug,i.templateId,i.status,i.updatedAt,i.pinHash,i.settings,i.data,t.published*c.published AS linkActive,COALESCE(r.replies,0) AS responseCount FROM page i JOIN templates t ON t.id=i.templateId JOIN categories c ON c.id=t.category LEFT JOIN counts r ON r.invitation=i.id ORDER BY i.updatedAt DESC,i.id DESC",
