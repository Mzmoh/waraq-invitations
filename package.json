{
  "name": "waraq-invitation-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x || 26.x"
  },
  "scripts": {
    "dev:design": "node scripts/design-studio.mjs",
    "test:e2e:kit": "node tests/cinematic-kit-browser.mjs",
    "dev": "node --env-file-if-exists=.env server/index.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs server/tests/*.test.mjs",
    "lint": "node scripts/check.mjs",
    "build": "node scripts/build.mjs",
    "test:e2e": "node tests/browser.mjs",
    "build:hosting": "node scripts/build-worker.mjs",
    "test:hosting": "node tests/worker-contract.mjs",
    "test:e2e:finishing": "node tests/finishing-browser.mjs",
    "test:e2e:dashboard": "node tests/dashboard-browser.mjs",
    "review:templates": "node tests/template-visuals.mjs",
    "backup": "node scripts/backup.mjs",
    "test:e2e:release": "node tests/release-browser.mjs",
    "build:trial": "node scripts/build-vercel.mjs",
    "test:trial": "node --test tests/trial/*.test.mjs",
    "test:e2e:cinematic": "node tests/cinematic-browser.mjs",
    "test:e2e:performance": "node tests/performance-browser.mjs",
    "test:e2e:photos": "node tests/photo-browser.mjs"
  },
  "devDependencies": {
    "esbuild": "0.27.0",
    "playwright": "1.62.1",
    "@electric-sql/pglite": "0.5.17"
  },
  "dependencies": {
    "pg": "8.16.3"
  }
}
